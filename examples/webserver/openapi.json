{
  "openapi": "3.1.0",
  "info": {
    "title": "html2pdf local webserver example",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Process runtime identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "os",
                    "arch",
                    "go"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "os": {
                      "type": "string"
                    },
                    "arch": {
                      "type": "string"
                    },
                    "go": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/render": {
      "post": {
        "operationId": "renderPDF",
        "summary": "Render bounded static HTML without external assets",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "html"
                ],
                "additionalProperties": false,
                "properties": {
                  "html": {
                    "type": "string",
                    "description": "At most 256 KiB UTF-8 HTML after JSON decoding"
                  },
                  "stylesheets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Ordered author CSS, aggregate CSS budget 128 KiB"
                  }
                }
              },
              "example": {
                "html": "<h1>Hello Indonesia</h1><p>Rp 1.234,56</p>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete preflighted PDF",
            "headers": {
              "X-PDF-Pages": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-PDF-Warnings": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, unknown field, missing html or trailing data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "Request cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Wire body or render quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type or encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid, unsupported, unbreakable document or missing resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Render slot busy; Retry-After: 1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Cooperative rendering deadline exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal render failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
